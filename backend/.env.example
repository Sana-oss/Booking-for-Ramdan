# CORINTHIA RAMADAN BOOKING — BACKEND ENVIRONMENT
# Copy to `.env` (never commit .env) and fill in real values.
# انسخ هذا الملف إلى .env واملأ القيم — لا ترفع ملف .env إلى GitHub أبداً

# MongoDB Atlas connection string for a LEAST-PRIVILEGE user
# (role: readWrite on CorinthiaDB only — not atlasAdmin)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=CorinthiaDB

# Random secret, at least 32 characters. If left empty, the server generates one
# automatically and stores it in backend/.jwt-secret. To set your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

PORT=5000
NODE_ENV=production

# Business rules (optional — defaults shown)
BUSINESS_TIMEZONE=Africa/Tripoli
MAX_DAILY_CAPACITY=200
PENDING_EXPIRY_HOURS=24

# Extra origins allowed to call the API cross-origin (comma-separated).
# Leave empty when the frontend is served by this server (normal setup).
CORS_ORIGINS=

# Used only by `npm run setup` to create the first superadmin
SETUP_ADMIN_USERNAME=
SETUP_ADMIN_PASSWORD=
SETUP_ADMIN_NAME=Administrator
